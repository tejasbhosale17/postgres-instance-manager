# Copy this file to .env for local development. Do not commit .env.
POSTGRES_DB=control_plane
POSTGRES_USER=control_plane
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=jdbc:postgresql://localhost:5433/control_plane
DATABASE_USERNAME=control_plane
DATABASE_PASSWORD=change-this-local-password
JWT_SIGNING_KEY=
CREDENTIAL_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
WORKER_POLL_DELAY_MS=500
WORKER_LEASE_DURATION_SECONDS=120
WORKER_LEASE_RENEWAL_MS=30000
WORKER_RECOVERY_DELAY_MS=30000
WORKER_RECONCILE_DELAY_MS=60000
